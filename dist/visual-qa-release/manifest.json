{
  "manifest_version": 3,
  "name": "PixelAudit 视觉走查助手",
  "short_name": "PixelAudit",
  "version": "1.0.7",
  "description": "网页视觉走查工具：快速查看尺寸、字体、颜色与间距，记录问题并导出走查结果。",
  "action": {
    "default_title": "PixelAudit 视觉走查助手（未开启）",
    "default_icon": {
      "16": "icons/action-off-16.png",
      "32": "icons/action-off-32.png"
    }
  },
  "permissions": ["scripting", "activeTab", "storage", "downloads"],
  "background": {
    "service_worker": "service_worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/ui/topbar/*.svg", "assets/ui/fuchuang/*.svg"],
      "matches": ["http://*/*", "https://*/*", "file://*/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
