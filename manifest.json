{
  "manifest_version": 3,
  "name": "视觉走查助手",
  "version": "1.0.0",
  "description": "在网页上查看元素尺寸、间距并测距。",
  "action": {
    "default_title": "视觉走查助手"
  },
  "permissions": ["scripting", "activeTab", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*", "file://*/*"],
  "background": {
    "service_worker": "service_worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
